{
  "expo": {
    "name": "closho-customer-app",
    "slug": "closho-customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/closho-logo-premium-transparent.png",
    "scheme": "closhocustomerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/closho-logo-premium-transparent.png",
      "bundleIdentifier": "com.closho.customerapp"
    },
    "android": {
      "package": "com.closho.customerapp",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/closho-logo-premium-transparent.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/closho-logo-premium-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/closho-logo-premium-transparent.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false,
    "updates": {
      "url": "https://u.expo.dev/ba12a1fb-1eae-4c46-bd89-d14440f7fb3f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba12a1fb-1eae-4c46-bd89-d14440f7fb3f"
      }
    }
  }
}
